{
  "name": "@bonya-ai/tyto",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Tyto API (Bonya Compute)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "proto": "bash scripts/gen-proto.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4"
  },
  "devDependencies": {
    "ts-proto": "^2.12.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
